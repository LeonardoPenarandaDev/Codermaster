RewriteEngine On

Options -Indexes

# Version en ingles: /en -> Inicio en ingles
RewriteRule ^en/?$ pages/index.php?lang=en [L,QSA]

# Version en ingles del detalle de proyecto: /en/portafolio/mi-proyecto
RewriteRule ^en/portafolio/([a-zA-Z0-9-]+)/?$ pages/portafolio-detalle.php?slug=$1&lang=en [L,QSA]

# Version en ingles de las demas paginas: /en/servicios, /en/precios, etc.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^en/([a-z-]+)/?$ pages/$1.php?lang=en [L,QSA,NC]

# Raiz -> Inicio
RewriteRule ^$ pages/index.php [L]

# Detalle de un proyecto: /portafolio/mi-proyecto -> pages/portafolio-detalle.php?slug=mi-proyecto
RewriteRule ^portafolio/([a-zA-Z0-9-]+)/?$ pages/portafolio-detalle.php?slug=$1 [L,QSA]

# Paginas: /servicios -> pages/servicios.php, /nosotros -> pages/nosotros.php, etc.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z-]+)/?$ pages/$1.php [L,QSA,NC]

# Si alguien entra directo a /pages/servicios.php, redirige a la URL amigable /servicios
RewriteCond %{THE_REQUEST} \s/+pages/([a-z-]+)\.php[\s?] [NC]
RewriteRule ^ /%1? [R=301,L]
